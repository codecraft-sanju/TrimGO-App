{
  "expo": {
    "name": "TrimGo",
    "slug": "trimgo-app",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trimgo.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TrimGo needs your location to show live tracking."
      }
    },
    "android": {
      "package": "com.trimgo.app",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "04a9dd93-ec68-4cc4-b027-72033150e17e"
      }
    }
  }
}